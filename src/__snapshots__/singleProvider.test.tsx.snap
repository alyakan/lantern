exports[`single provider: the chat box > the footer and meta line 1`] = `
<div>
  <div
    class="composer"
  >
    <div
      class="composer-box"
      style=""
    >
      <div
        class="composer-line"
      >
        <textarea
          aria-label="Message to Claude"
          autocapitalize="off"
          autocorrect="off"
          placeholder="Ask Claude…"
          rows="1"
          spellcheck="true"
          style="height: 0px;"
        />
      </div>
      <div
        class="composer-footer"
      >
        <div
          class="model-picker"
        >
          <button
            aria-expanded="false"
            aria-haspopup="menu"
            class="composer-item model-button"
            title="Models: Standard · Your model and effort, Claude Code's own settings · Effort High"
          >
            <svg
              aria-hidden="true"
              fill="none"
              height="12"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.3"
              viewBox="0 0 12 12"
              width="12"
            >
              <path
                d="M5.3 3Q5.9 6.7 9.8 7.3Q5.9 7.9 5.3 11.3Q4.7 7.9 0.8 7.3Q4.7 6.7 5.3 3Z"
              />
              <path
                d="M9.6 1Q9.8 2.1 11 2.3Q9.8 2.5 9.6 3.6Q9.4 2.5 8.2 2.3Q9.4 2.1 9.6 1Z"
              />
            </svg>
            Standard · Opus 5.5
            <span
              aria-hidden="true"
              class="chev down"
            />
          </button>
        </div>
        <div
          class="spacer"
        />
        <span
          class="context-meter"
          title="61,480 of 200,000 tokens of context used
Last turn took 8.2s
This chat so far: $0.90 · 400k tokens"
        >
          <button
            aria-expanded="false"
            aria-label="31% of context used"
            class="context-used"
            type="button"
          >
            <span>
              31%
            </span>
          </button>
        </span>
        <button
          aria-label="Send"
          class="send"
          disabled=""
          title="Send (Enter)"
        >
          <svg
            aria-hidden="true"
            fill="none"
            height="12"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 12 12"
            width="12"
          >
            <path
              d="M6 10V2M2.5 5.5 6 2l3.5 3.5"
            />
          </svg>
        </button>
      </div>
    </div>
    <div
      class="composer-meta"
    >
      <div
        class="model-picker mode-menu-anchor"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Permissions: Ask"
          class="meta-item mode-chip"
          title="Permissions: Edits apply; commands and other actions ask you first"
        >
          <svg
            aria-hidden="true"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.3"
            viewBox="0 0 12 13"
            width="12"
          >
            <path
              d="M6 1 1.5 2.8v3.4c0 2.8 1.9 4.9 4.5 5.8 2.6-.9 4.5-3 4.5-5.8V2.8z"
            />
          </svg>
          Ask
          <span
            aria-hidden="true"
            class="chev down"
          />
        </button>
      </div>
      <div
        class="model-picker mode-menu-anchor"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Workflow: Chat"
          class="meta-item mode-chip"
          title="Workflow: A plain conversation: Claude works as you ask"
        >
          <svg
            aria-hidden="true"
            fill="none"
            height="12"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.3"
            viewBox="0 0 12 12"
            width="12"
          >
            <path
              d="M5.3 3Q5.9 6.7 9.8 7.3Q5.9 7.9 5.3 11.3Q4.7 7.9 0.8 7.3Q4.7 6.7 5.3 3Z"
            />
            <path
              d="M9.6 1Q9.8 2.1 11 2.3Q9.8 2.5 9.6 3.6Q9.4 2.5 8.2 2.3Q9.4 2.1 9.6 1Z"
            />
          </svg>
          Chat
          <span
            aria-hidden="true"
            class="chev down"
          />
        </button>
      </div>
      <div
        class="spacer"
      />
      <span
        class="meta-item static"
        title="Git branch"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="13"
