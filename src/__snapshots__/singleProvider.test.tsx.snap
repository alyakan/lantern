exports[`single provider: a team's canvas > the + Agent form 1`] = `
<form
  aria-label="New agent"
  class="new-agent canvas-overlay"
  id="_r_a_"
  role="dialog"
>
  <label>
    Role
    <select>
      <option
        value=""
      >
        No role · a blank brief
      </option>
      <optgroup
        label="Built in"
      >
        <option
          value="builder"
        >
          Builder
        </option>
        <option
          value="reviewer"
        >
          Reviewer
        </option>
        <option
          value="qa"
        >
          QA / tester
        </option>
        <option
          value="docs"
        >
          Docs
        </option>
        <option
          value="security"
        >
          Security auditor
        </option>
      </optgroup>
    </select>
  </label>
  <label>
    Task
    <textarea
      aria-invalid="false"
      aria-required="true"
      autocapitalize="off"
      autocorrect="off"
      placeholder="What should it do? This is the brief it starts from."
      rows="4"
      spellcheck="false"
    />
  </label>
  <label>
    Name 
    <span
      class="new-agent-optional"
    >
      optional
    </span>
    <input
      maxlength="60"
      placeholder="Named from the task"
      value=""
    />
  </label>
  <fieldset>
    <legend>
      Where it works
    </legend>
    <label
      class="new-agent-choice"
    >
      <input
        checked=""
        name="isolation"
        type="radio"
      />
      Own worktree
    </label>
    <label
      class="new-agent-choice"
    >
      <input
        name="isolation"
        type="radio"
      />
      Shared folder
    </label>
    <p
      class="new-agent-hint"
    >
      Shared is for work that writes nothing: it reads your folder as it is.
    </p>
  </fieldset>
  <label>
    Model
    <select>
      <option
        value=""
      >
        Default
         · 
        Claude Code's setting
      </option>
      <option
        value="opus"
      >
        Opus
         · 
        Most capable
      </option>
      <option
        value="sonnet"
      >
        Sonnet
         · 
        Fast and capable
      </option>
      <option
        value="haiku"
      >
        Haiku
         · 
        Fastest
      </option>
    </select>
  </label>
  <div
    class="new-agent-roles"
  >
    <button
      class="link-button"
      type="button"
    >
      Save as a role…
    </button>
  </div>
  <div
    class="new-agent-actions"
  >
    <button
      type="button"
    >
      Cancel
    </button>
    <button
      class="primary"
      type="submit"
    >
      Start agent
    </button>
  </div>
</form>
`;

