{
  "expo": {
    "name": "Lantern",
    "slug": "lantern",
    "scheme": "lantern",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alyakan.lantern",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lantern finds your Mac on this Wi-Fi and connects to it.",
        "NSBonjourServices": [
          "_lantern._tcp"
        ],
        "NSCameraUsageDescription": "Lantern reads the pairing code your Mac shows.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.alyakan.lantern",
      "adaptiveIcon": {
        "backgroundColor": "#EEF1F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#EEF1F4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161E27"
          }
        }
      ],
      "expo-iap",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lantern asks for Face ID to unlock itself, only if you turn the lock on."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lantern listens only while dictation is on, to turn your voice into text for the message box.",
          "speechRecognitionPermission": "Lantern turns your voice into text for the message box. Your phone does this itself where it can; for other languages Apple's speech service does."
        }
      ]
    ]
  }
}
