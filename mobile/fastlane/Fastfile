# Lantern phone app: release automation, run from `mobile/`.
#
#   fastlane check             # nothing is built or sent: says what a release would use, and what is missing
#   fastlane ios archive       # build and sign for the App Store, upload nothing (the dry run of beta)
#   fastlane ios notes         # say what the next build's notes would be (what changed since the last tagged build); sends nothing
#   fastlane ios beta          # build for the App Store and upload to TestFlight, with those notes as What to Test and in the app
#   fastlane android beta      # build a signed bundle and upload it to Google Play's internal testing track
#
# Nothing secret is in this file or in the repository. Each secret stays on this Mac and is named by a variable:
#
#   ASC_KEY_ID, ASC_ISSUER_ID     the App Store Connect API key (the key file itself is ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8)
#   ANDROID_KEYSTORE              path to the upload keystore (keep it, and a backup of it, outside the repository)
#   ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#   PLAY_JSON_KEY                 path to the Google Play service account's JSON key
#
# The Android build needs Android Studio's own JDK: JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home".

default_platform(:ios)

BUNDLE_ID = "com.alyakan.lantern"
# The Live Activity's widget extension (expo-widgets' default id): it is signed and uploaded inside the app, with a profile of its own.
WIDGET_ID = "#{BUNDLE_ID}.ExpoWidgetsTarget"
# The notification service extension (targets/notification-service): it opens the text a push from the Mac carries. It is signed
# and uploaded inside the app too, with a profile of its own. It needs no App Group and no capability: its keychain group
# (<team>.com.alyakan.lantern.push) is covered by the TEAMID.* every App Store profile carries.
NOTIFICATION_ID = "#{BUNDLE_ID}.NotificationService"
# A team id is printed on every app in the store: it is not a secret.
TEAM_ID = ENV["APPLE_TEAM_ID"] || "2NT5QR24SX"

# What a release must not have: the preview switch for made-up tips (the build then thanks for a tip nobody paid).
def refuse_preview_build!
  if ENV["EXPO_PUBLIC_FAKE_TIPS"] == "1"
    UI.user_error!("EXPO_PUBLIC_FAKE_TIPS=1 is set: that is for previews, and would put made-up tips in a release. Unset it.")
  end
  # Expo's bundler also reads mobile/.env* files into EXPO_PUBLIC_ variables, so the switch can hide in one of those.
  Dir.glob(File.join(mobile_dir, ".env*")).each do |file|
    next unless File.file?(file)
    if File.read(file).match?(/^\s*(export\s+)?EXPO_PUBLIC_FAKE_TIPS\s*=\s*["']?1/)
      UI.user_error!("#{File.basename(file)} sets EXPO_PUBLIC_FAKE_TIPS=1: that is for previews, and would put made-up tips in a release. Remove it.")
    end
  end
end

def need(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set (see the top of mobile/fastlane/Fastfile).") if value.empty?
  value
end

def mobile_dir
  File.expand_path("..", __dir__)
end

# The version in app.json: what the stores call the release.
def app_version
  require "json"
  JSON.parse(File.read(File.join(mobile_dir, "app.json")))["expo"]["version"]
end

# Each phone build is tagged with its number, so the next one can say what changed since. (The Mac's releases are the v* tags.)
BUILD_TAG = "mobile-build-"
# TestFlight's limit for the "What to Test" text.
TESTFLIGHT_NOTES_MAX = 4000

# The phone build before this commit, by its tag; nil when none was tagged yet.
def previous_build_tag
  tag = `git -C #{mobile_dir} describe --tags --abbrev=0 --match '#{BUILD_TAG}*' HEAD 2>/dev/null`.strip
  tag.empty? ? nil : tag
end

# What changed in the phone app since the previous build (scripts/build-notes.sh), one entry per bullet. Nothing when no build
# was tagged yet: there is nothing to count from, and a guess would put the whole history in the notes.
def whats_new
  previous = previous_build_tag
  unless previous
    UI.important("No #{BUILD_TAG}* tag yet, so there is nothing to say what is new since. Tag the last build (git tag -a #{BUILD_TAG}<app version>-<number> <commit>).")
    return []
  end
  out = `#{File.join(mobile_dir, "scripts", "build-notes.sh")} #{previous} HEAD`
  UI.user_error!("scripts/build-notes.sh failed, so the notes can't be made.") unless $?.success?
  UI.message("Since #{previous}:\n#{out}")
  out.lines.map { |l| l.strip.sub(/\A- /, "") }.reject(&:empty?)
end

# The notes as TestFlight's text: bullets, cut at a whole bullet to fit its limit (in bytes: that is how Apple counts).
def testflight_notes(bullets)
  lines = bullets.map { |b| "- #{b}\n" }
  return lines.join if lines.join.bytesize <= TESTFLIGHT_NOTES_MAX
  kept = []
  # Room is kept for the line that says how many were left out.
  lines.each do |line|
    break if (kept + [line]).join.bytesize > TESTFLIGHT_NOTES_MAX - 60
    kept << line
  end
  kept.join + "…and #{lines.size - kept.size} more changes."
end

# What the build carries, for the app's own "What's new" (src/releaseNotes.json). Only a release build has anything in it.
def write_app_notes(build_number, bullets)
  require "json"
  File.write(File.join(mobile_dir, "src", "releaseNotes.json"), JSON.pretty_generate({ version: app_version, build: build_number, notes: bullets }) + "\n")
end

# The same notes as a file beside the .ipa (mobile/build, which git ignores): to read, or to paste where the lane can't reach.
def write_notes_file(build_number, bullets)
  out = File.join(mobile_dir, "build")
  FileUtils.mkdir_p(out)
  body = bullets.empty? ? "Nothing new to say.\n" : bullets.map { |b| "- #{b}\n" }.join
  File.write(File.join(out, "RELEASE_NOTES.md"), "# Lantern #{app_version}, build #{build_number}\n\n#{body}")
end

desc "Say what a release would use and what is missing; nothing is built or sent"
lane :check do
  refuse_preview_build!
  UI.message("Version #{app_version}, id #{BUNDLE_ID}, team #{TEAM_ID}")
  problems = []

  key_id = ENV["ASC_KEY_ID"].to_s
  key_file = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  problems << "ASC_KEY_ID is not set" if key_id.empty?
  problems << "ASC_ISSUER_ID is not set" if ENV["ASC_ISSUER_ID"].to_s.empty?
  problems << "no App Store Connect key at #{key_file}" unless !key_id.empty? && File.exist?(key_file)

  keystore = ENV["ANDROID_KEYSTORE"].to_s
  problems << "ANDROID_KEYSTORE is not set, or is not a file" if keystore.empty? || !File.exist?(File.expand_path(keystore))
  %w[ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD].each { |n| problems << "#{n} is not set" if ENV[n].to_s.empty? }
  play = ENV["PLAY_JSON_KEY"].to_s
  problems << "PLAY_JSON_KEY is not set, or is not a file" if play.empty? || !File.exist?(File.expand_path(play))

  if problems.empty?
    UI.success("Everything a release needs is here.")
  else
    UI.important("Missing for a release:\n  - #{problems.join("\n  - ")}")
  end
end

platform :ios do
  def asc_key
    key_id = need("ASC_KEY_ID")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: need("ASC_ISSUER_ID"),
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8"),
      in_house: false,
    )
  end

  # (gym hands `xcargs` to the export step as well as the archive step, so they are given once there: an `export_xcargs` with the
  # same key flags makes xcodebuild refuse the export, "-authenticationKeyPath may only be provided once".)
  # Xcode signs with the same App Store Connect API key the upload uses (when ASC_KEY_ID and ASC_ISSUER_ID are set), so it needs
  # no Apple ID signed in to it, and can register what a capability needs (an App ID, an App Group, a profile) on its own.
  def xcode_auth
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer = ENV["ASC_ISSUER_ID"].to_s
    return "" if key_id.empty? || issuer.empty?
    "-authenticationKeyPath #{File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer}"
  end

  # Registers the App ID `id` through the API key when the developer account has none (an existing one is left alone): a profile
  # can only be made for an App ID that exists, and Xcode only registers one while it signs, which is after the profiles are made.
  # It needs no capability; the app's and the widget's ids were made by Xcode and are found here. (`key` is what asc_key returned:
  # the app_store_connect_api_key action has already given Spaceship its token.)
  def ensure_app_id(id)
    found = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: id }).any? { |b| b.identifier == id }
    return UI.message("App ID #{id} exists.") if found
    UI.important("Registering the App ID #{id} (it did not exist).")
    Spaceship::ConnectAPI::BundleId.create(name: "Lantern #{id.split(".").last}", platform: "IOS", identifier: id)
  end

  # The App Store profiles for the app, its widget and its notification extension, made through the API key when one is missing
  # (an existing one is used), as { id => profile name }: the export signs with them by name. Needs the Apple Distribution
  # certificate in this Mac's keychain.
  def app_store_profiles(key)
    [BUNDLE_ID, WIDGET_ID, NOTIFICATION_ID].each_with_object({}) do |id, names|
      ensure_app_id(id) if id == NOTIFICATION_ID
      get_provisioning_profile(app_identifier: id, api_key: key, provisioning_name: "Lantern #{id} App Store", team_id: TEAM_ID)
      names[id] = lane_context[SharedValues::SIGH_NAME]
    end
  end

  desc "Build and sign for the App Store, and upload nothing: the dry run of `beta`, which needs no app in App Store Connect"
  lane :archive do
    refuse_preview_build!
    profiles = app_store_profiles(asc_key)
    sh("cd #{mobile_dir} && npx expo prebuild --platform ios --clean")
    build_app(
      workspace: File.join(mobile_dir, "ios", "Lantern.xcworkspace"),
      scheme: "Lantern",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      clean: true,
      output_directory: File.join(mobile_dir, "build"),
      output_name: "Lantern.ipa",
      xcargs: "-allowProvisioningUpdates #{xcode_auth} DEVELOPMENT_TEAM=#{TEAM_ID} CURRENT_PROJECT_VERSION=1",
      export_xcargs: "-allowProvisioningUpdates",
    )
    UI.success("Built and signed mobile/build/Lantern.ipa. Nothing was uploaded.")
  end

  desc "Say what the next build's notes would be (what changed since the last tagged build); nothing is built or sent"
  lane :notes do
    bullets = whats_new
    UI.success(bullets.empty? ? "Nothing new to say." : "TestFlight's What to Test would be:\n#{testflight_notes(bullets)}")
  end

  desc "Build for the App Store and upload the build to TestFlight"
  lane :beta do
    refuse_preview_build!
    key = asc_key
    profiles = app_store_profiles(key)
    # TestFlight wants each build of a version to have a number above the last one's.
    last = latest_testflight_build_number(api_key: key, app_identifier: BUNDLE_ID, version: app_version, initial_build_number: 0)
    build_number = last + 1
    UI.message("Build #{build_number} of #{app_version}")
    bullets = whats_new
    notes_file = File.join(mobile_dir, "src", "releaseNotes.json")
    begin
      # The notes go into the app (shown once after an update) and are what TestFlight shows testers.
      write_app_notes(build_number, bullets)
      beta_build(key, build_number, bullets, profiles)
    ensure
      # The file in the repository is the empty default: a build's notes are never left in the working tree to be committed.
      sh("git -C #{mobile_dir} checkout -- #{notes_file}")
    end
    tag = "#{BUILD_TAG}#{app_version}-#{build_number}"
    sh("git -C #{mobile_dir} tag -a #{tag} -m 'Phone build #{build_number} of #{app_version}' HEAD")
    UI.success("Uploaded build #{build_number}. Tagged #{tag} here: push it (git push origin #{tag}) so the next build counts from it. Add the build to a tester group in App Store Connect (testers inside your team need no review; an outside group needs a short beta review).")
  end

  def beta_build(key, build_number, bullets, profiles)
    # The native project is generated from app.json, never kept: every release starts from it.
    sh("cd #{mobile_dir} && npx expo prebuild --platform ios --clean")
    # Expo writes CFBundleVersion into the generated Info.plist as a fixed "1", which no build setting changes: it is set here.
    sh("/usr/libexec/PlistBuddy -c 'Set :CFBundleVersion #{build_number}' '#{File.join(mobile_dir, "ios", "Lantern", "Info.plist")}'")

    build_app(
      workspace: File.join(mobile_dir, "ios", "Lantern.xcworkspace"),
      scheme: "Lantern",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      clean: true,
      output_directory: File.join(mobile_dir, "build"),
      output_name: "Lantern.ipa",
      xcargs: "-allowProvisioningUpdates #{xcode_auth} DEVELOPMENT_TEAM=#{TEAM_ID} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates",
    )

    # With a changelog, fastlane waits only until the build shows up in App Store Connect (to set What to Test), not for processing.
    # It would wait for ever if the build never showed up, so it gives up after a quarter of an hour.
    options = { api_key: key, skip_waiting_for_build_processing: true, skip_submission: true, wait_processing_timeout_duration: 900 }
    options[:changelog] = testflight_notes(bullets) unless bullets.empty?
    write_notes_file(build_number, bullets)
    begin
      upload_to_testflight(**options)
    rescue StandardError => e
      # Waiting for the build to show up can fail after the upload went through. Then the build is there (and is tagged, by the
      # lane), but its What to Test was not set: say so. If it is not there, the upload itself failed.
      there = latest_testflight_build_number(api_key: key, app_identifier: BUNDLE_ID, version: app_version, initial_build_number: 0) >= build_number
      raise e unless there
      UI.important("Build #{build_number} was uploaded, but #{e.message}\nIts What to Test may not be set: it is in mobile/build/RELEASE_NOTES.md, to set in App Store Connect.")
    end
  end
end

platform :android do
  desc "Build a signed bundle and upload it to Google Play's internal testing track"
  lane :beta do
    refuse_preview_build!
    keystore = File.expand_path(need("ANDROID_KEYSTORE"))
    UI.user_error!("No keystore at #{keystore}") unless File.exist?(keystore)
    json_key = File.expand_path(need("PLAY_JSON_KEY"))
    UI.user_error!("No Play key at #{json_key}") unless File.exist?(json_key)

    # Google wants every upload to have a version code above the last one's: minutes since 1970 always are.
    code = Time.now.to_i / 60
    UI.message("Version #{app_version}, version code #{code}")

    sh("cd #{mobile_dir} && npx expo prebuild --platform android --clean")
    gradle_file = File.join(mobile_dir, "android", "app", "build.gradle")
    text = File.read(gradle_file)
    UI.user_error!("The generated build.gradle has no versionCode to set.") unless text.match?(/versionCode \d+/)
    File.write(gradle_file, text.sub(/versionCode \d+/, "versionCode #{code}"))

    gradle(
      project_dir: File.join(mobile_dir, "android"),
      task: "bundle",
      build_type: "Release",
      # The command line carries the keystore's passwords: it is not printed (or kept in fastlane's logs).
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => keystore,
        "android.injected.signing.store.password" => need("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => need("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => need("ANDROID_KEY_PASSWORD"),
      },
    )

    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key: json_key,
      aab: File.join(mobile_dir, "android", "app", "build", "outputs", "bundle", "release", "app-release.aab"),
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("Uploaded to the internal testing track. Promote it to a closed or open test from Play Console.")
  end
end
