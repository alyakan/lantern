{
  "title": "Staging data",
  "panels": [
    {
      "type": "form",
      "id": "org",
      "title": "Create org",
      "fields": [
        {
          "id": "staging",
          "type": "select",
          "label": "Staging",
          "required": true,
          "options": [
            "1",
            "2",
            "3",
            "7",
            "9"
          ]
        },
        {
          "id": "users",
          "type": "number",
          "label": "Users",
          "required": false,
          "default": 2,
          "min": 1.0,
          "max": 50.0
        },
        {
          "id": "admins",
          "type": "number",
          "label": "Admins",
          "required": false,
          "default": 1,
          "min": 0.0
        },
        {
          "id": "addons",
          "type": "multiselect",
          "label": "Addons on",
          "required": false,
          "default": [
            "approvals"
          ],
          "optionsFrom": {
            "command": [
              "python3",
              "~/tools/lumi_staging.py",
              "addons",
              "--staging",
              "{staging}",
              "--json"
            ],
            "dependsOn": [
              "staging"
            ]
          }
        },
        {
          "id": "name",
          "type": "text",
          "label": "Org name",
          "required": false,
          "default": "QA org"
        },
        {
          "id": "trial",
          "type": "toggle",
          "label": "Trial",
          "required": false,
          "default": false
        }
      ],
      "action": {
        "command": [
          "python3",
          "lumi_staging.py",
          "create",
          "--json",
          "--staging",
          "{staging}",
          "--users",
          "{users}",
          "--admins",
          "{admins}",
          "--enable",
          "{addons}",
          "--name={name}",
          "--trial={trial}"
        ],
        "confirm": "Creates a real org on staging {staging}",
        "output": "json"
      }
    },
    {
      "type": "result",
      "of": "org"
    },
    {
      "type": "history",
      "id": "runs",
      "title": "Past runs",
      "of": "org"
    }
  ]
}
