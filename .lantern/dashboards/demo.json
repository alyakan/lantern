{
  "title": "Staging data (demo)",
  "panels": [
    {
      "type": "form",
      "id": "org",
      "title": "Create org",
      "fields": [
        { "id": "staging", "type": "select", "label": "Staging", "options": ["1", "2", "3", "7", "9"], "required": true },
        { "id": "users", "type": "number", "label": "Users", "default": 2, "min": 1, "max": 50 },
        { "id": "admins", "type": "number", "label": "Admins", "default": 1, "min": 0 },
        { "id": "addons", "type": "multiselect", "label": "Addons on", "optionsFrom": { "command": ["python3", "/tmp/dashboard-demo/demo.py", "addons", "--staging", "{staging}"], "dependsOn": ["staging"] }, "default": ["approvals"] },
        { "id": "name", "type": "text", "label": "Org name", "default": "QA org" },
        { "id": "trial", "type": "toggle", "label": "Trial", "default": false }
      ],
      "action": {
        "command": ["python3", "/tmp/dashboard-demo/demo.py", "create", "--staging", "{staging}", "--users", "{users}", "--admins", "{admins}", "--enable", "{addons}", "--name={name}", "--trial={trial}"],
        "confirm": "Pretends to create an org on staging {staging} (nothing real happens)",
        "output": "json"
      }
    },
    { "type": "result", "of": "org" },
    { "type": "history", "id": "runs", "title": "Past runs", "of": "org" },
    {
      "type": "form",
      "id": "users",
      "title": "Add users",
      "fields": [
        { "id": "staging", "type": "select", "label": "Staging", "options": ["1", "2", "3", "7", "9"], "required": true },
        { "id": "org", "type": "number", "label": "Org id", "default": 4242, "min": 1 },
        { "id": "count", "type": "number", "label": "How many", "default": 3, "min": 1, "max": 50 },
        { "id": "role", "type": "select", "label": "Role", "options": ["user", "admin"], "default": "user" }
      ],
      "action": {
        "command": ["python3", "/tmp/dashboard-demo/demo.py", "add-users", "--staging", "{staging}", "--org", "{org}", "--count", "{count}", "--role", "{role}"],
        "confirm": "Pretends to add {count} {role}(s) to org {org} on staging {staging}",
        "output": "json"
      }
    },
    { "type": "result", "of": "users" },
    { "type": "history", "id": "user-runs", "title": "Past runs", "of": "users" },
    {
      "type": "form",
      "id": "addons",
      "title": "Set addons",
      "fields": [
        { "id": "staging", "type": "select", "label": "Staging", "options": ["1", "2", "3", "7", "9"], "required": true },
        { "id": "org", "type": "number", "label": "Org id", "default": 4242, "min": 1 },
        { "id": "on", "type": "multiselect", "label": "Turn on", "optionsFrom": { "command": ["python3", "/tmp/dashboard-demo/demo.py", "addons", "--staging", "{staging}"], "dependsOn": ["staging"] } },
        { "id": "off", "type": "multiselect", "label": "Turn off", "optionsFrom": { "command": ["python3", "/tmp/dashboard-demo/demo.py", "addons", "--staging", "{staging}"], "dependsOn": ["staging"] } }
      ],
      "action": {
        "command": ["python3", "/tmp/dashboard-demo/demo.py", "set-addons", "--staging", "{staging}", "--org", "{org}", "--enable", "{on}", "--disable", "{off}"],
        "confirm": "Pretends to change addons on org {org} (staging {staging})",
        "output": "json"
      }
    },
    { "type": "result", "of": "addons" },
    { "type": "history", "id": "addon-runs", "title": "Past runs", "of": "addons" }
  ]
}
